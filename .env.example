VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only if your Supabase project still uses an anon key:
# VITE_SUPABASE_ANON_KEY=

# Cashfree Subscriptions / UPI AutoPay
# Configure these as Supabase Edge Function secrets, never as VITE_* variables:
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_WEBHOOK_SECRET=       # optional; falls back to CASHFREE_CLIENT_SECRET
# CASHFREE_ENVIRONMENT=sandbox   # change to production when going live
# CASHFREE_API_VERSION=2025-01-01
