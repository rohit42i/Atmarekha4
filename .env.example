# Browser-visible configuration only. These values are public in the built bundle.
VITE_SITE_URL=https://www.atmarekha.in
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_MEDIA_WORKER_URL=https://your-media-worker.example
VITE_ANALYTICS_WORKER_URL=https://your-analytics-worker.example

# Legacy fallback, only if your Supabase project has not migrated to publishable keys.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Omit worker URL overrides to use the documented production defaults. URLs are public.

# Never place service-role keys, payment secrets, Cloudflare tokens, or SMTP passwords
# in VITE_* variables. Configure those only in the server/worker secret store.
