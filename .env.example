VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only if your Supabase project still uses an anon key:
# VITE_SUPABASE_ANON_KEY=

# Razorpay Standard Checkout (public key only; safe for frontend builds)
VITE_RAZORPAY_KEY_ID=

# Razorpay server secrets belong in Supabase Edge Function secrets, never in VITE_* variables:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
