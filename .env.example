VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, only if your Supabase project still uses an anon key:
# VITE_SUPABASE_ANON_KEY=

# Razorpay Subscriptions / UPI AutoPay
# Configure these as Supabase Edge Function secrets, never as VITE_* variables:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
