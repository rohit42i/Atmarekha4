# Static assets are content-hashed by Vite, so they can be cached safely for a long time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Images can be cached for a day and revalidated, avoiding stale replacements.
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.avif
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Keep browser HTML validation behavior unchanged, while allowing the CDN edge
# to serve the static shell briefly without going back to the origin.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=60

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=300, stale-while-revalidate=60
